rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /announcements/{teacherId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == teacherId
                   && request.resource.size < 15 * 1024 * 1024;
    }
  }
}
